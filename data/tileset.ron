// Dwarf Kingdom tileset config.
//
// To use different art (downloaded, commissioned, or AI-generated):
//   1. Put the sprite sheet at assets/<image> (a regular grid of tiles).
//   2. Set tile_px / columns / rows to match the sheet.
//   3. Point each glyph name at the right cell index (row-major from 0).
//   4. List in `tinted` the glyphs drawn in grayscale that should be
//      colored by material/plant at runtime; all others render as-is.
// Delete this file to fall back to flat colored squares.
//
// The default assets/tileset.png is generated by tools/make_tileset.py
// and is CC0 / public domain.
TilesetDef(
    image: "tileset.png",
    tile_px: 32,
    columns: 6,
    rows: 11,
    glyphs: {
        "wall": 0, "floor": 1, "stairs": 2, "ramp": 3, "gate": 4, "farm": 5,
        "block": 6, "boulder": 7, "seed": 8, "crop": 9, "dwarf": 10,
        "raider": 11, "meal": 12, "drink": 13, "artifact": 14, "still": 15,
        "kitchen": 16, "lever": 17, "tomb": 18, "cow": 19, "sheep": 20,
        "dog": 21, "weapon": 22, "tree": 23, "tree_conifer": 24,
        "tree_willow": 25, "tree_birch": 26, "grass_a": 27, "grass_b": 28,
        "grass_c": 29, "dirt_a": 30, "dirt_b": 31, "rock_a": 32, "rock_b": 33,
        "water": 34, "bush": 35, "stone": 36, "reed": 37,
        "ws_forge": 38, "ws_furnace": 39, "ws_loom": 40, "ws_mason": 41,
        "ws_carpenter": 42, "ws_bench": 43, "ws_cloth": 44, "ws_hides": 45,
        "ws_well": 46, "i_log": 47, "i_bar": 48, "i_barrel": 49, "i_bin": 50,
        "i_bed": 51, "i_clothes": 52, "i_statue": 53, "i_instrument": 54,
        "i_armor": 55, "i_gem": 56, "i_cloth": 57, "i_leather": 58, "i_wool": 59,
        "i_glass": 60, "i_craft": 61,
    },
    tinted: ["wall", "floor", "stairs", "ramp", "gate", "farm", "block",
             "boulder", "seed", "crop", "tree", "tree_conifer",
             "tree_willow", "tree_birch", "grass_a", "grass_b", "grass_c",
             "dirt_a", "dirt_b", "rock_a", "rock_b", "water", "bush", "stone",
             "reed", "i_log", "i_bar", "i_barrel", "i_bin", "i_bed", "i_clothes",
             "i_statue", "i_instrument", "i_armor", "i_gem", "i_cloth",
             "i_leather", "i_wool", "i_glass", "i_craft"],
)
