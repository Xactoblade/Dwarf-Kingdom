// Dwarf Kingdom tileset config.
//
// To use different art (downloaded, commissioned, or AI-generated):
//   1. Put the sprite sheet at assets/<image> (a regular grid of tiles).
//   2. Set tile_px / columns / rows to match the sheet.
//   3. Point each glyph name at the right cell index (row-major from 0).
//   4. List in `tinted` the glyphs drawn in grayscale that should be
//      colored by material/plant at runtime; all others render as-is.
// Delete this file to fall back to flat colored squares.
//
// The default assets/tileset.png is generated by tools/make_tileset.py
// and is CC0 / public domain.
TilesetDef(
    image: "tileset.png",
    tile_px: 32,
    columns: 6,
    rows: 4,
    glyphs: {
        "wall": 0, "floor": 1, "stairs": 2, "ramp": 3, "gate": 4, "farm": 5,
        "block": 6, "boulder": 7, "seed": 8, "crop": 9, "dwarf": 10,
        "raider": 11, "meal": 12, "drink": 13, "artifact": 14, "still": 15,
        "kitchen": 16, "lever": 17, "tomb": 18, "cow": 19, "sheep": 20,
    },
    tinted: ["wall", "floor", "stairs", "ramp", "gate", "farm", "block",
             "boulder", "seed", "crop"],
)
