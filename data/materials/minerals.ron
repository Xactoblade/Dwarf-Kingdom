// Dwarf Kingdom material raws — Phase 0 set.
// Colors are sRGB display colors; value is a relative trade multiplier.
[
    // --- Soils ---
    MaterialDef(id: "loam",      name: "Loam",      category: Soil,        color: (121, 85, 58),   value: 1),
    MaterialDef(id: "clay",      name: "Clay",      category: Soil,        color: (158, 101, 74),  value: 1),
    MaterialDef(id: "sand",      name: "Sand",      category: Soil,        color: (194, 172, 118), value: 1),

    // --- Sedimentary stone ---
    MaterialDef(id: "sandstone",     name: "Sandstone",     category: Sedimentary, color: (176, 145, 97),  value: 1),
    // Limestone is a flux stone — smelt it with iron to make steel.
    MaterialDef(id: "limestone",     name: "Limestone",     category: Sedimentary, color: (184, 178, 160), value: 1, is_flux: true),
    MaterialDef(id: "shale",         name: "Shale",         category: Sedimentary, color: (106, 110, 118), value: 1),
    MaterialDef(id: "mudstone",      name: "Mudstone",      category: Sedimentary, color: (128, 112, 96),  value: 1),
    MaterialDef(id: "siltstone",     name: "Siltstone",     category: Sedimentary, color: (150, 138, 120), value: 1),
    MaterialDef(id: "chalk",         name: "Chalk",         category: Sedimentary, color: (232, 230, 222), value: 1, is_flux: true),
    MaterialDef(id: "dolomite",      name: "Dolomite",      category: Sedimentary, color: (198, 190, 175), value: 1, is_flux: true),
    MaterialDef(id: "chert",         name: "Chert",         category: Sedimentary, color: (120, 116, 108), value: 1),
    MaterialDef(id: "conglomerate",  name: "Conglomerate",  category: Sedimentary, color: (160, 130, 110), value: 1),

    // --- Igneous stone ---
    MaterialDef(id: "granite",   name: "Granite",   category: Igneous,     color: (140, 130, 128), value: 1),
    MaterialDef(id: "basalt",    name: "Basalt",    category: Igneous,     color: (72, 70, 74),    value: 1),
    MaterialDef(id: "gabbro",    name: "Gabbro",    category: Igneous,     color: (88, 92, 88),    value: 1),
    MaterialDef(id: "diorite",   name: "Diorite",   category: Igneous,     color: (150, 150, 155), value: 1),
    MaterialDef(id: "rhyolite",  name: "Rhyolite",  category: Igneous,     color: (170, 130, 120), value: 1),
    MaterialDef(id: "andesite",  name: "Andesite",  category: Igneous,     color: (120, 112, 108), value: 1),
    // Obsidian: volcanic glass — dark, and sharp enough to edge a blade.
    MaterialDef(id: "obsidian",  name: "Obsidian",  category: Igneous,     color: (28, 26, 34),    value: 3,
        combat: CombatStats(sharpness: 2.6, density: 2.4, hardness: 55.0)),

    // --- Metamorphic stone ---
    // Marble is a flux stone as well as a fine building stone.
    MaterialDef(id: "marble",    name: "Marble",    category: Metamorphic, color: (214, 210, 200), value: 2, is_flux: true),
    MaterialDef(id: "gneiss",    name: "Gneiss",    category: Metamorphic, color: (120, 108, 100), value: 1),
    MaterialDef(id: "slate",     name: "Slate",     category: Metamorphic, color: (78, 82, 92),    value: 1),
    MaterialDef(id: "quartzite", name: "Quartzite", category: Metamorphic, color: (206, 198, 190), value: 2),
    MaterialDef(id: "schist",    name: "Schist",    category: Metamorphic, color: (110, 116, 110), value: 1),
    MaterialDef(id: "phyllite",  name: "Phyllite",  category: Metamorphic, color: (96, 100, 104),  value: 1),

    // --- Ores ---
    MaterialDef(id: "hematite",  name: "Hematite",   category: Ore,        color: (155, 66, 58),   value: 8,
        combat: CombatStats(sharpness: 1.0, density: 7.8, hardness: 100.0)),  // forges into iron
    MaterialDef(id: "magnetite", name: "Magnetite",  category: Ore,        color: (60, 56, 66),    value: 8,
        combat: CombatStats(sharpness: 1.0, density: 7.8, hardness: 100.0)),  // iron
    MaterialDef(id: "galena",    name: "Galena",     category: Ore,        color: (130, 134, 150), value: 10,
        combat: CombatStats(sharpness: 0.6, density: 11.3, hardness: 25.0)),  // lead: heavy and soft
    MaterialDef(id: "cassiterite", name: "Cassiterite", category: Ore,     color: (110, 90, 60),   value: 12,
        combat: CombatStats(sharpness: 0.8, density: 7.3, hardness: 30.0)),  // tin: soft
    MaterialDef(id: "native_gold", name: "Native Gold", category: Ore,     color: (222, 178, 62),  value: 30,
        combat: CombatStats(sharpness: 0.7, density: 19.3, hardness: 20.0)),  // gold: for show, not war

    // --- Alloys (made at the smelter, never mined) ---
    // Steel: iron smelted with flux. Harder and keener than iron — the finest
    // war-metal short of adamantine.
    MaterialDef(id: "steel", name: "Steel", category: Alloy, color: (176, 182, 194), value: 40,
        combat: CombatStats(sharpness: 1.3, density: 7.85, hardness: 150.0)),
]
